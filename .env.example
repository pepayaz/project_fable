DATABASE_URL="file:./prisma/dev.db"

# Set to true only for portfolio/demo production deployments using SQLite.
# Production defaults to rejecting SQLite. See docs/DB_MIGRATION.md.
# ALLOW_SQLITE_PRODUCTION="true"

# Required for production seed. Leave password empty for local demo fallback only.
SEED_ADMIN_NAME="Project Fable Admin"
SEED_ADMIN_EMAIL="admin@fable.local"
SEED_ADMIN_PASSWORD=""

# AI is optional. Empty GEMINI_API_KEY keeps AI features gracefully disabled.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash-lite"
